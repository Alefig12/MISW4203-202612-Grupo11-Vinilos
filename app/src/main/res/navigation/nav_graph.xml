<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/albumListFragment">

    <fragment
        android:id="@+id/albumListFragment"
        android:name="com.example.vinilos_grupo11.ui.albums.AlbumListFragment"
        android:label="@string/nav_albums"
        tools:layout="@layout/fragment_album_list">
        <action
            android:id="@+id/action_albumListFragment_to_albumDetailFragment"
            app:destination="@id/albumDetailFragment" />
        <action
            android:id="@+id/action_albumListFragment_to_createAlbumFragment"
            app:destination="@id/createAlbumFragment" />
    </fragment>

    <fragment
        android:id="@+id/createAlbumFragment"
        android:name="com.example.vinilos_grupo11.ui.albums.CreateAlbumFragment"
        android:label="@string/create_album_title"
        tools:layout="@layout/fragment_create_album" />

    <fragment
        android:id="@+id/albumDetailFragment"
        android:name="com.example.vinilos_grupo11.ui.albums.AlbumDetailFragment"
        android:label="@string/album_label"
        tools:layout="@layout/fragment_album_detail">
        <argument
            android:name="albumId"
            android:defaultValue="-1"
            app:argType="integer" />
        <action
            android:id="@+id/action_albumDetailFragment_to_addTrackFragment"
            app:destination="@id/addTrackFragment" />
    </fragment>

    <fragment
        android:id="@+id/addTrackFragment"
        android:name="com.example.vinilos_grupo11.ui.albums.AddTrackFragment"
        android:label="@string/add_track_title"
        tools:layout="@layout/fragment_add_track">
        <argument
            android:name="albumId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/artistListFragment"
        android:name="com.example.vinilos_grupo11.ui.artists.ArtistsFragment"
        android:label="@string/nav_artists" />

    <fragment
        android:id="@+id/collectorListFragment"
        android:name="com.example.vinilos_grupo11.ui.collectors.CollectorsFragment"
        android:label="@string/nav_collectors">
        <action
            android:id="@+id/action_collectorListFragment_to_collectorDetailFragment"
            app:destination="@id/collectorDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/artistDetailFragment"
        android:name="com.example.vinilos_grupo11.ui.artists.ArtistDetailFragment"
        android:label="Detalle de Artista">
        <argument
            android:name="artistId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/collectorDetailFragment"
        android:name="com.example.vinilos_grupo11.ui.collectors.CollectorDetailFragment"
        android:label="@string/collector_label"
        tools:layout="@layout/fragment_collector_detail">
        <argument
            android:name="collectorId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

</navigation>
